# ----------------------------------------------------------------------
# VibeBite — environment variables
# Copy to .env and fill in real values. Never commit .env.
# Every key here is documented in implementation.md sec 11.4.
# ----------------------------------------------------------------------

# Environment: dev | staging | prod
ENV=dev
LOG_LEVEL=INFO

# ---- Database -------------------------------------------------------
# Used by services/api, services/agents, services/worker.
# Default: file-based SQLite (zero install — just works).
DATABASE_URL=sqlite+aiosqlite:///./vibebite.db
# For Postgres on RunPod / production:
# DATABASE_URL=postgresql+psycopg://vibebite:vibebite@localhost:5432/vibebite

# Optional override for LangGraph's checkpointer DB (defaults to DATABASE_URL)
LANGGRAPH_DATABASE_URL=

# ---- Redis ----------------------------------------------------------
# Cache + Celery/Dramatiq broker
REDIS_URL=redis://localhost:6379/0

# ---- Auth -----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-real-env
JWT_REFRESH_SECRET=change-me-in-real-env

# ---- LLM ------------------------------------------------------------
# Provider selection: "gemini" (default), "openai", or "stub".
# `stub` uses the keyword-based fixture LLM — no key needed.
LLM_PROVIDER=gemini

# Gemini (free tier; aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# OpenAI (only needed if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Google Places --------------------------------------------------
GOOGLE_PLACES_API_KEY=

# ---- Expo Push Notifications ---------------------------------------
EXPO_ACCESS_TOKEN=

# ---- Telemetry ------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Each service overrides with its own name (api, agents, mcp, worker)
OTEL_SERVICE_NAME=vibebite-api

# Optional error reporting
SENTRY_DSN=

# ---- MCP ------------------------------------------------------------
# If unset, MCP server runs in stdio mode (recommended for local dev)
MCP_SERVER_PORT=
